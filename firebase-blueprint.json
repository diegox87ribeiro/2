{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated INVEST AI user profile metadata",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "displayName", "createdAt", "updatedAt"]
    },
    "AgentInsight": {
      "title": "AgentInsight",
      "description": "Structured insight generated by Analista, Gestor, or Auditor agent",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "agentRole": { "type": "string", "enum": ["ANALISTA", "GESTOR", "AUDITOR"], "description": "Specialized agent role" },
        "ticker": { "type": "string", "description": "Target asset ticker" },
        "conclusion": { "type": "string", "enum": ["Comprar", "Manter", "Vender", "Aguardar"], "description": "Agent recommendation conclusion" },
        "confidence": { "type": "integer", "description": "Confidence score 0-100" },
        "thesis": { "type": "string", "description": "Investment thesis summary" },
        "sourceLabel": { "type": "string", "description": "Data source consulted" },
        "dataBase": { "type": "string", "description": "Reference base date" },
        "indicatorsSummary": { "type": "string", "description": "Key indicators summary" },
        "risksSummary": { "type": "string", "description": "Identified risks summary" },
        "scenariosSummary": { "type": "string", "description": "Optimistic, base, pessimistic scenarios" },
        "usedPersonalData": { "type": "boolean", "description": "Whether personal HHI summary was explicitly authorized" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "agentRole", "ticker", "conclusion", "confidence", "thesis", "usedPersonalData", "createdAt", "updatedAt"]
    },
    "ConsolidatedReport": {
      "title": "ConsolidatedReport",
      "description": "Executive management report aggregating Analista, Gestor, and Auditor insights",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "tickerFilter": { "type": "string", "description": "Ticker scope or GERAL" },
        "consensusConclusion": { "type": "string", "enum": ["Comprar", "Manter", "Vender", "Aguardar"], "description": "Aggregated consensus" },
        "averageConfidence": { "type": "integer", "description": "Average confidence across covered agents (0-100)" },
        "coveredAgentsCount": { "type": "integer", "description": "Number of agents represented (1-3)" },
        "analystSummary": { "type": "string", "description": "Latest Analista summary" },
        "gestorSummary": { "type": "string", "description": "Latest Gestor summary" },
        "auditorSummary": { "type": "string", "description": "Latest Auditor summary" },
        "combinedRisks": { "type": "string", "description": "Consolidated audit and HHI risks" },
        "totalEquityBrl": { "type": "number", "description": "Real portfolio equity snapshot in BRL" },
        "hhiScore": { "type": "number", "description": "Portfolio HHI concentration score" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "tickerFilter", "consensusConclusion", "averageConfidence", "coveredAgentsCount", "totalEquityBrl", "hhiScore", "createdAt", "updatedAt"]
    },
    "PortfolioSnapshot": {
      "title": "PortfolioSnapshot",
      "description": "Cloud backup metadata of imported real portfolio snapshot",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "fileName": { "type": "string", "description": "Imported CSV/XLSX filename" },
        "fileType": { "type": "string", "description": "CSV, XLSX, or MANUAL" },
        "recordCount": { "type": "integer", "description": "Count of active positions" },
        "totalEquityBrl": { "type": "number", "description": "Total real equity in BRL" },
        "cashBalanceBrl": { "type": "number", "description": "Cash balance in BRL" },
        "hhiScore": { "type": "number", "description": "HHI score" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "fileName", "fileType", "recordCount", "totalEquityBrl", "cashBalanceBrl", "hhiScore", "createdAt", "updatedAt"]
    },
    "CloudAsset": {
      "title": "CloudAsset",
      "description": "User asset document stored in Firestore for cross-device sync and Gemini executive auditing",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "ticker": { "type": "string", "description": "Normalized asset ticker (e.g. PETR4, HGLG11)" },
        "name": { "type": "string", "description": "Asset display name" },
        "assetClass": { "type": "string", "enum": ["ACOES_BR", "FII", "FIAGRO", "ETF", "RENDA_FIXA", "CRIPTO"], "description": "Asset class code" },
        "sector": { "type": "string", "description": "Asset sector or segment" },
        "quantity": { "type": "number", "description": "Position quantity held by user" },
        "averagePrice": { "type": "number", "description": "Average acquisition price in BRL" },
        "currentPrice": { "type": "number", "description": "Latest unit price in BRL" },
        "dy12m": { "type": "number", "description": "12-month dividend yield percentage" },
        "pvp": { "type": "number", "description": "Price to Book ratio (P/VP)" },
        "pl": { "type": "number", "description": "Price to Earnings ratio (P/L)" },
        "roe": { "type": "number", "description": "Return on Equity percentage" },
        "dailyLiquidityMillions": { "type": "number", "description": "Average daily liquidity in BRL millions" },
        "dataComDay": { "type": "integer", "description": "Typical Data-Com day of month (0 if not applicable, 1-31)" },
        "cyclical": { "type": "boolean", "description": "Whether the asset follows cyclical Data-Com groups G1-G4" },
        "demoData": { "type": "boolean", "description": "Whether indicators originate from illustrative catalog data" },
        "sourceLabel": { "type": "string", "description": "Data source label" },
        "dataBaseDate": { "type": "string", "description": "Reference base date for asset data" },
        "riskSummary": { "type": "string", "description": "Baseline risk notes stored with the asset" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "ticker", "name", "assetClass", "sector", "quantity", "averagePrice", "currentPrice", "dy12m", "pvp", "pl", "roe", "dailyLiquidityMillions", "dataComDay", "cyclical", "demoData", "sourceLabel", "dataBaseDate", "riskSummary", "createdAt", "updatedAt"]
    },
    "AssetAuditSummary": {
      "title": "AssetAuditSummary",
      "description": "Executive audit summary of risks and opportunities generated by Gemini from a Firestore asset",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "assetId": { "type": "string", "description": "Firestore asset document ID analyzed" },
        "ticker": { "type": "string", "description": "Asset ticker" },
        "assetName": { "type": "string", "description": "Asset display name" },
        "riskLevel": { "type": "string", "enum": ["BAIXO", "MODERADO", "ALTO", "CRITICO"], "description": "Overall audit risk classification" },
        "auditScore": { "type": "integer", "description": "Audit quality/health score (0-100)" },
        "verdict": { "type": "string", "enum": ["FAVORAVEL", "NEUTRO", "CAUTELA", "EVITAR"], "description": "Executive audit verdict" },
        "executiveSummary": { "type": "string", "description": "Executive audit summary in pt-BR" },
        "risksJson": { "type": "string", "description": "JSON array of structured risk items" },
        "opportunitiesJson": { "type": "string", "description": "JSON array of structured opportunity items" },
        "inconsistencyAlertsJson": { "type": "string", "description": "JSON array of data inconsistency flags" },
        "auditRecommendation": { "type": "string", "description": "Actionable analytical next step" },
        "modelName": { "type": "string", "description": "Gemini model identifier used for audit" },
        "sourceSnapshotLabel": { "type": "string", "description": "Origin snapshot label from Firestore asset" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["userId", "assetId", "ticker", "assetName", "riskLevel", "auditScore", "verdict", "executiveSummary", "risksJson", "opportunitiesJson", "inconsistencyAlertsJson", "auditRecommendation", "modelName", "sourceSnapshotLabel", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user profile document"
    },
    "/users/{userId}/agent_insights/{insightId}": {
      "schema": { "$ref": "#/entities/AgentInsight" },
      "description": "Persisted AI insights from Analista, Gestor, and Auditor"
    },
    "/users/{userId}/consolidated_reports/{reportId}": {
      "schema": { "$ref": "#/entities/ConsolidatedReport" },
      "description": "Saved consolidated executive management reports"
    },
    "/users/{userId}/portfolio_snapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/PortfolioSnapshot" },
      "description": "Cloud-synced real portfolio snapshot summaries"
    },
    "/users/{userId}/assets/{assetId}": {
      "schema": { "$ref": "#/entities/CloudAsset" },
      "description": "User-synced asset records available for Gemini executive auditing"
    },
    "/users/{userId}/asset_audits/{auditId}": {
      "schema": { "$ref": "#/entities/AssetAuditSummary" },
      "description": "Executive risk and opportunity audit summaries generated by Gemini"
    }
  }
}
